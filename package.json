{
  "name": "lanternfall",
  "version": "0.9.0",
  "description": "Lanternfall: a dark-fantasy castle-defense action game in the browser (three.js).",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=esm --target=es2020 --minify --outfile=public/game.js",
    "dev": "esbuild src/main.js --bundle --format=esm --target=es2020 --outdir=public --entry-names=game --servedir=public --serve=8080",
    "assets:fetch": "bash tools/fetch-assets.sh",
    "assets": "node tools/build-assets.mjs"
  },
  "dependencies": {
    "three": "^0.181.2",
    "n8ao": "^2.1.0",
    "postprocessing": "^6.37.0"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.34.0"
  },
  "engines": {
    "node": ">=18"
  }
}